# Constants
# --------------------------------------------------------------------------
STANDARD_AA = set("ACDEFGHIKLMNPQRSTVWY")
IL_BYTES = bytes.maketrans(b"I", b"L")          # I -> L equivalence

# After I->L merging there are 19 distinct letters; code each in 5 bits so up
# to 12 residues fit in one uint64 key.
KEY_ALPHABET = "ACDEFGHKLMNPQRSTVWY"
KEY_BITS = 5
MAX_K = 12
AA_CODE = np.zeros(256, dtype=np.uint8)         # 0 = anything else ('*', 'X')
for _i, _ch in enumerate(KEY_ALPHABET, start=1):
    AA_CODE[ord(_ch)] = _i
CODE_OF = {ch: i for i, ch in enumerate(KEY_ALPHABET, start=1)}

PRE_BITS = 24                                   # cheap pre-filter table size
PRE_MASK = np.uint64((1 << PRE_BITS) - 1)
CHUNK = 8_000_000                               # windows scanned per block

# Nucleotide coding T,C,A,G = 0,1,2,3 so the standard code string below
# (TCAG order) can be indexed as 16*b1 + 4*b2 + b3. Complement = (x + 2) % 4.
NT_CODE = np.full(256, 4, dtype=np.uint8)
for _v, _b in enumerate("TCAG"):
    NT_CODE[ord(_b)] = _v
    NT_CODE[ord(_b.lower())] = _v
CODON_AA = np.frombuffer(
    b"FFLLSSSSYY**CC*WLLLLPPPPHHQQRRRRIIIMTTTTNNKKSSRRVVVVAAAADDEEGGGG",
    dtype=np.uint8,
)

# Processing-site motifs used for structural context (edit to taste).
DIBASIC = {"KR", "RR"}                          # add "KK", "RK" if desired

# Kyte-Doolittle hydropathy for the crude signal-peptide heuristic.
KD = {"A": 1.8, "R": -4.5, "N": -3.5, "D": -3.5, "C": 2.5, "Q": -3.5,
      "E": -3.5, "G": -0.4, "H": -3.2, "I": 4.5, "L": 3.8, "K": -3.9,
      "M": 1.9, "F": 2.8, "P": -1.6, "S": -0.8, "T": -0.7, "W": -0.9,
      "Y": -1.3, "V": 4.2}

