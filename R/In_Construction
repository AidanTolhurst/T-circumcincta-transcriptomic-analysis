# --------------------------------------------------------------------------
# I/O helpers
# --------------------------------------------------------------------------
def open_text(path):
    """Open a text file, detecting zip, gzip and UTF-16 from the file's first
    bytes (not its name). Plain files are read as UTF-8; utf-8-sig strips the
    invisible byte-order mark Excel adds to 'CSV UTF-8' files, and any stray
    undecodable byte becomes a replacement character instead of a crash."""
    with open(path, "rb") as fh:
        magic = fh.read(2)
    if magic == b"PK":                               # zip (e.g. NCBI Datasets)
        zf = zipfile.ZipFile(path)
        wanted = (".faa", ".fa", ".fasta", ".fna", ".fas")
        members = [m for m in zf.namelist() if m.lower().endswith(wanted)]
        if len(members) != 1:
            sys.exit(f"{path} is a zip archive and I need exactly one FASTA "
                     f"file inside it; found {members or 'none'} among "
                     f"{zf.namelist()[:10]}. Unzip it and point the script at "
                     "the right file.")
        print(f"[note] reading {members[0]} from inside the zip {path}",
              file=sys.stderr)
        return io.TextIOWrapper(zf.open(members[0]), encoding="utf-8-sig",
                                errors="replace")
    if magic == b"\x1f\x8b":                         # gzip, whatever it is named
        return gzip.open(path, "rt", encoding="utf-8-sig", errors="replace")
    if magic in (b"\xff\xfe", b"\xfe\xff"):          # UTF-16 (e.g. PowerShell)
        return open(path, encoding="utf-16", errors="replace")
    return open(path, encoding="utf-8-sig", errors="replace")


def read_fasta(path):
    """Yield (name, sequence) from a plain or gzipped FASTA file."""
    name, chunks, first = None, [], True
    with open_text(path) as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            if first:
                first = False
                if line[0] != ">":
                    sys.exit(f"{path} does not look like a FASTA file: the "
                             f"first line starts {line[:40]!r}. Open it in a "
                             "text editor and check the download.")
            if line[0] == ">":
                if name is not None:
                    yield name, "".join(chunks)
                parts = line[1:].split()
                name, chunks = (parts[0] if parts else ""), []
            else:
                chunks.append(line)
    if name is not None:
        yield name, "".join(chunks)


def check_fasta(path, kind):
    """Cheap sanity check of a database file, run for every database before
    the long searches start, so a bad file fails in seconds, not hours."""
    residues, n, first = [], 0, True
    with open_text(path) as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            if first:
                first = False
                if line[0] != ">":
                    sys.exit(f"{path} does not look like a FASTA file: the "
                             f"first line starts {line[:40]!r}.")
                continue
            if line[0] == ">":
                continue
            residues.append(line.upper())
            n += len(line)
            if n >= 5000:
                break
    seq = "".join(residues)
    if not seq:
        sys.exit(f"{path} has no sequence under its first header.")
    nt_frac = sum(seq.count(c) for c in "ACGTUN") / len(seq)
    if kind == "protein" and nt_frac > 0.95:
        sys.exit(f"{path} looks like DNA, not protein. Use a protein FASTA "
                 "here (put genome files under GENOME).")
    if kind == "dna" and nt_frac < 0.8:
        sys.exit(f"{path} looks like protein, not DNA. Use a nucleotide "
                 "FASTA for GENOME.")


@dataclass
class Query:
    qid: int
    name: str
    seq: str
    kind: str          # "real", "reverse" or "shuffle"
    parent: int        # qid of the real peptide this was derived from
    rep: int = 0       # shuffle replicate number

    @property
    def norm(self) -> str:
        return self.seq.replace("I", "L")


def read_peptide_table(path, column):
    """Read a CSV/text file with a header (default 'pepseq') and one peptide
    per row. Returns (name, sequence) pairs, where the name is the row number
    in the file ('pep_row2' = the first peptide under the header)."""
    with open_text(path) as fh:
        raw = fh.read().splitlines()

    # Find the header row: the first non-blank line.
    first = next((i for i, ln in enumerate(raw) if ln.strip()), None)
    if first is None:
        return []
    def squash(text):                  # 'Pep_Seq', 'pep seq' -> 'pepseq'
        return re.sub(r"[\W_]+", "", text.lower())

    head_cells = [squash(c) for c in re.split(r"[,;\t]", raw[first])]
    has_header = squash(column) in head_cells
    col = head_cells.index(squash(column)) if has_header else 0
    start = first + 1 if has_header else first

    entries = []
    for i in range(start, len(raw)):
        line = raw[i].strip()
        if not line:
            continue
        cells = [c.strip().strip('"') for c in re.split(r"[,;\t]", line)]
        seq = cells[col] if col < len(cells) else ""
        if not seq:
            continue
        # Use a second column as the name if one exists, otherwise the row.
        extra = [c for j, c in enumerate(cells) if j != col and c]
        name = extra[0] if extra else f"pep_row{i + 1}"
        entries.append((name, seq))
    return entries


def load_peptides(path, column="pepseq"):
    with open_text(path) as fh:
        head = fh.readline()
    if head.lstrip().startswith(">"):
        entries = list(read_fasta(path))
    else:
        entries = read_peptide_table(path, column)

    peptides = []
    for name, seq in entries:
        seq = seq.upper().strip().strip("*")
        bad = set(seq) - STANDARD_AA
        if not seq or bad:
            print(f"[warn] skipping {name!r}: unusable residues {sorted(bad)}",
                  file=sys.stderr)
            continue
        if len(seq) < 6:
            print(f"[warn] {name!r} is only {len(seq)} residues; expect many "
                  "chance matches", file=sys.stderr)
        peptides.append(Query(len(peptides), name, seq, "real", len(peptides)))
    return peptides


def make_decoys(real, n_shuffles, seed):
    """Reversed and shuffled copies; each preserves length and composition."""
    rng = random.Random(seed)
    real_norms = {p.norm for p in real}
    decoys, skipped = [], 0

    def add(seq, kind, parent, rep):
        decoys.append(Query(len(real) + len(decoys),
                            f"{kind}:{real[parent].name}", seq, kind, parent, rep))

    for p in real:
        rev = p.seq[::-1]
        if rev.replace("I", "L") in real_norms:     # palindrome / equals a real
            skipped += 1
        else:
            add(rev, "reverse", p.qid, 0)
        for r in range(n_shuffles):
            for _ in range(50):
                letters = list(p.seq)
                rng.shuffle(letters)
                s = "".join(letters)
                if s.replace("I", "L") not in real_norms:
                    break
            else:                                   # e.g. low-complexity peptide
                skipped += 1
                continue
            add(s, "shuffle", p.qid, r)
    return decoys, skipped


# --------------------------------------------------------------------------
# Structural context of a hit
# --------------------------------------------------------------------------
def signal_like(segment: str, hit_offset: int) -> bool:
    """Crude check: hydrophobic stretch in the first 35 residues after the
    first Met, with the peptide lying downstream. Heuristic only - use
    SignalP / DeepTMHMM for anything you report."""
    m = segment.find("M")
    if m == -1 or hit_offset - m < 20:
        return False
    region = segment[m:m + 35]
    vals = [KD.get(c, 0.0) for c in region]
    return any(sum(vals[i:i + 8]) / 8 >= 1.6 for i in range(3, len(vals) - 7))


def hit_context(hay: str, s: int, e: int, flank: int = 4) -> dict:
    """Context for hay[s:e]. 'hay' is a protein, or one translated frame in
    which '*' marks stops; the surrounding stop-to-stop stretch is treated as
    the precursor."""
    seg_start = hay.rfind("*", 0, s) + 1
    stop = hay.find("*", e)
    seg_end = len(hay) if stop == -1 else stop
    up = hay[max(seg_start, s - flank):s]
    down = hay[e:min(seg_end, e + flank)]

    if s == seg_start:
        n_site = "segment_start"
    elif up[-2:] in DIBASIC:
        n_site = "dibasic"
    elif up[-1:] in ("K", "R"):
        n_site = "monobasic"
    else:
        n_site = "none"

    if e == seg_end:
        c_site = "segment_end"
    elif down[:2] in DIBASIC:
        c_site = "dibasic"
    elif down[:1] in ("K", "R"):
        c_site = "monobasic"
    else:
        c_site = "none"

    # Amidated peptides: the precursor carries a Gly right after the peptide,
    # followed by a processing site.
    if down[:1] == "G":
        if down[1:3] in DIBASIC:
            amid = "G+dibasic"
        elif down[1:2] in ("K", "R"):
            amid = "G+monobasic"
        else:
            amid = "G"
    else:
        amid = "none"

    sig = signal_like(hay[seg_start:seg_end], s - seg_start)
    support = (
        (n_site in ("dibasic", "monobasic"))
        + (c_site in ("dibasic", "monobasic") or amid in ("G+dibasic", "G+monobasic"))
        + sig
    )
    return {"upstream": up, "downstream": down, "n_site": n_site,
            "c_site": c_site, "amidation_signal": amid,
            "signal_like_nterm": sig, "precursor_len": seg_end - seg_start,
            "context_support": support}


# --------------------------------------------------------------------------
# Exact-match search engine
# --------------------------------------------------------------------------
def encode_key(s: str) -> int:
    v = 0
    for ch in s:
        v = (v << KEY_BITS) | CODE_OF[ch]
    return v


class Searcher:
    """Finds every exact occurrence of every query (reals and decoys) in one
    pass per database.

    Each residue is coded in 5 bits, so a k-residue window becomes one uint64
    key. A cheap lookup table discards almost all windows, and the survivors
    are checked with a binary search. Peptides longer than 12 residues use
    their first 12 residues as the key and are then verified in full.
    """

    def __init__(self, queries, max_hits):
        self.queries = queries
        self.max_hits = max_hits
        self.counts = np.zeros(len(queries), dtype=np.int64)
        self.stored = defaultdict(int)
        self.rows = []
        self.comp = defaultdict(int)         # residue counts (I merged into L)
        self.positions = 0

        by_k = defaultdict(lambda: defaultdict(list))
        for q in queries:
            k = min(len(q.norm), MAX_K)
            by_k[k][encode_key(q.norm[:k])].append(q.qid)
        self.tables = {}
        for k, d in by_k.items():
            ordered = sorted(d)
            keys = np.array(ordered, dtype=np.uint64)
            table = np.zeros(1 << PRE_BITS, dtype=bool)
            table[(keys & PRE_MASK).astype(np.intp)] = True
            self.tables[k] = (keys, [d[x] for x in ordered], table)

    def _iter_hits(self, norm, codes):
        for k, (keys, qlists, table) in self.tables.items():
            nwin = len(codes) - k + 1
            for off in range(0, nwin, CHUNK):
                w = min(CHUNK, nwin - off)
                block = codes[off:off + w + k - 1]
                key = np.zeros(w, dtype=np.uint64)
                for j in range(k):
                    key <<= np.uint64(KEY_BITS)
                    key |= block[j:j + w]
                cand = np.flatnonzero(table[(key & PRE_MASK).astype(np.intp)])
                if cand.size == 0:
                    continue
                ck = key[cand]
                idx = np.minimum(np.searchsorted(keys, ck), len(keys) - 1)
                ok = keys[idx] == ck
                for p, i in zip(cand[ok].tolist(), idx[ok].tolist()):
                    pos = off + p
                    for qi in qlists[i]:
                        n = len(self.queries[qi].norm)
                        if n > k and norm[pos:pos + n] != self.queries[qi].norm:
                            continue
                        yield qi, pos

    def scan(self, norm: str, locate, flank: int):
        """norm: sequence with I->L; locate(pos, n) -> (fields, orig, s, e)."""
        for ch in KEY_ALPHABET:
            self.comp[ch] += norm.count(ch)
        self.positions += len(norm)
        codes = AA_CODE[np.frombuffer(norm.encode("ascii", "replace"), dtype=np.uint8)]

        for qi, pos in self._iter_hits(norm, codes):
            self.counts[qi] += 1
            q = self.queries[qi]
            if q.kind != "real" or self.stored[qi] >= self.max_hits:
                continue                      # decoys are only counted
            self.stored[qi] += 1
            fields, hay, s, e = locate(pos, len(q.norm))
            row = {"peptide_id": q.name, "peptide": q.seq, "length": len(q.seq),
                   **fields, "matched_seq": hay[s:e],
                   "il_variant": hay[s:e] != q.seq, "_qid": q.qid}
            row.update(hit_context(hay, s, e, flank))
            self.rows.append(row)

    def expected(self, q: Query):
        """(composition-aware, naive 20^-n) expected random matches."""
        total = max(sum(self.comp.values()), 1)
        p = 1.0
        for ch in q.norm:
            p *= self.comp[ch] / total
        return self.positions * p, self.positions * 20.0 ** -len(q.seq)


