        f"peptides searched: {n_real}  (+ {n_decoys} decoys)",
        f"shuffles per peptide: {args.n_shuffles}   seed: {args.seed}   "
        f"max hits: {args.max_hits}   flank: {args.flank}",
        "",
        "Inputs",
    ]
    for role, fpath in inputs:
        print(f"[info] checksumming {fpath} ...", file=sys.stderr)
        lines += [
            f"- {role}: {os.path.basename(fpath)}",
            f"    size:   {os.path.getsize(fpath):,} bytes",
            f"    sha256: {sha256_of(fpath)}",
            f"    note:   {DATA_NOTES.get(role, '')}",
        ]
        if role in searchers:
            lines.append(f"    searched: {seq_counts[role]:,} sequences, "
                         f"{searchers[role].positions:,} positions")
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(lines) + "\n")


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("peptides", help="CSV with a 'pepseq' column, or FASTA")
    ap.add_argument("--column", default="pepseq",
                    help="header of the peptide column in a CSV (default pepseq)")
    ap.add_argument("--proteome", help="predicted proteome (protein FASTA)")
    ap.add_argument("--genome", help="genome assembly (nucleotide FASTA)")
    ap.add_argument("--host-proteome", help="host proteome, e.g. Ovis aries")
    ap.add_argument("--n-shuffles", type=int, default=100,
                    help="shuffled decoys per peptide (default 100; 0 = none)")
    ap.add_argument("--seed", type=int, default=1)
    ap.add_argument("--max-hits", type=int, default=1000,
                    help="max hit rows stored per peptide per database")
    ap.add_argument("--flank", type=int, default=4,
                    help="flanking residues reported either side of a hit")
    ap.add_argument("--out", default="peptide_mapping", help="output prefix")
    if len(sys.argv) == 1:          # run from IDLE: use the settings above
        argv = [PEPTIDES, "--out", OUT, "--n-shuffles", str(N_SHUFFLES)]
        for flag, path in (("--proteome", PROTEOME), ("--genome", GENOME),
                           ("--host-proteome", HOST_PROTEOME)):
            if path:
                argv += [flag, path]
        files = [PEPTIDES] + [p for p in (PROTEOME, GENOME, HOST_PROTEOME) if p]
        missing = [f for f in files if not os.path.exists(f)]
        if missing:
            sys.exit("File(s) not found: " + "; ".join(missing))
        if not (PROTEOME or GENOME or HOST_PROTEOME):
            sys.exit("Set PROTEOME, GENOME and/or HOST_PROTEOME at the top of "
                     "the script first (they are currently None).")
        sys.argv += argv
    args = ap.parse_args()

    dbs = [("proteome", args.proteome, search_proteome),
           ("genome", args.genome, search_genome),
           ("host", args.host_proteome, search_proteome)]
    dbs = [(n, p, f) for n, p, f in dbs if p]
    if not dbs:
        ap.error("give at least one of --proteome / --genome / --host-proteome")

    for _name, _path, _func in dbs:
        check_fasta(_path, "dna" if _func is search_genome else "protein")

    real = load_peptides(args.peptides, args.column)
    if not real:
        sys.exit("no usable peptides")
    decoys, skipped = make_decoys(real, args.n_shuffles, args.seed)
    queries = real + decoys
    print(f"{len(real)} peptides, {len(decoys)} decoys "
          f"({skipped} decoys skipped: palindromic/low-complexity)",
          file=sys.stderr)

    searchers, seq_counts = {}, {}
    for name, path, func in dbs:
        print(f"[{name}] searching {path} ...", file=sys.stderr)
        s = Searcher(queries, args.max_hits)
        n = func(path, s, args.flank)
        print(f"[{name}] {n} sequences, {s.positions:,} positions searched",
              file=sys.stderr)
        searchers[name] = s
        seq_counts[name] = n

    # ---- hits table
    hit_rows = []
    for name, s in searchers.items():
        for r in s.rows:
            hit_rows.append({"database": name, **r})
    write_tsv(f"{args.out}.hits.tsv", hit_rows, HIT_FIELDS)

    # ---- per-peptide summary
    shuffles_of, reverse_of = defaultdict(list), {}
    for d in decoys:
        (shuffles_of[d.parent].append(d) if d.kind == "shuffle"
         else reverse_of.__setitem__(d.parent, d))

    summary, fields = [], ["peptide_id", "peptide", "length"]
    for p in real:
        row = {"peptide_id": p.name, "peptide": p.seq, "length": len(p.seq)}
        for name, s in searchers.items():
            E, E_naive = s.expected(p)
            k = sum(s.counts[d.qid] > 0 for d in shuffles_of[p.qid])
            n = len(shuffles_of[p.qid])
            rev = reverse_of.get(p.qid)
            row.update({
                f"{name}_hits": int(s.counts[p.qid]),
                f"{name}_expected_random": f"{E:.3g}",
                f"{name}_expected_naive": f"{E_naive:.3g}",
                f"{name}_p_chance_match": f"{-math.expm1(-E):.3g}",
                f"{name}_shuffle_hits": f"{k}/{n}" if n else "NA",
                f"{name}_empirical_p": f"{(k + 1) / (n + 1):.3g}" if n else "NA",
                f"{name}_reverse_hits": int(s.counts[rev.qid]) if rev else "NA",
            })
        target = [s for nme, s in searchers.items() if nme != "host"]
        support = [r["context_support"] for s in target for r in s.rows
                   if r["_qid"] == p.qid]
        row["best_context_support"] = max(support) if support else ""
        if "proteome" in searchers and row["proteome_hits"]:
            status = "in_predicted_proteome"
        elif "genome" in searchers and row["genome_hits"]:
            status = ("genome_only" if "proteome" in searchers
                      else "in_genome")
        else:
            status = "not_found"
        if "host" in searchers and row["host_hits"]:
            status += ";ALSO_IN_HOST"
        row["status"] = status
        summary.append(row)
    for name in searchers:
        fields += [f"{name}_{c}" for c in (
            "hits", "expected_random", "expected_naive", "p_chance_match",
            "shuffle_hits", "empirical_p", "reverse_hits")]
    fields += ["best_context_support", "status"]
    write_tsv(f"{args.out}.peptide_summary.tsv", summary, fields)

    # ---- null by length
    null_rows = []
    for name, s in searchers.items():
        null_rows += null_table(name, queries, s.counts)
    write_tsv(f"{args.out}.null_by_length.tsv", null_rows,
              ["database", "length", "n_peptides", "real_hit_rate",
               "reverse_hit_rate", "shuffle_hit_rate_mean",
               "shuffle_hit_rate_min", "shuffle_hit_rate_max"])

    # ---- run information (inputs, checksums, settings, versions)
    inputs = [("peptides", args.peptides)] + [(n, p) for n, p, f in dbs]
    write_run_info(f"{args.out}.run_info.txt", args, inputs, seq_counts,
                   searchers, len(real), len(decoys))

    # ---- console summary
    print("\nHit rate (fraction of peptides with >=1 exact match):")
    for r in null_rows:
        if r["length"] == "all":
            print(f"  {r['database']:9s} real={r['real_hit_rate']}  "
                  f"reversed={r['reverse_hit_rate']}  "
                  f"shuffled={r['shuffle_hit_rate_mean']} "
                  f"({r['shuffle_hit_rate_min']}-{r['shuffle_hit_rate_max']})")
    counts = defaultdict(int)
    for r in summary:
        counts[r["status"]] += 1
    print("\nStatus:", dict(counts))
    print(f"\nWrote {args.out}.hits.tsv, .peptide_summary.tsv, "
          ".null_by_length.tsv and .run_info.txt")


if __name__ == "__main__":
    main()
