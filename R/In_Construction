def write_tsv(path, rows, fields):
    with open(path, "w", newline="") as fh:
        w = csv.DictWriter(fh, fieldnames=fields, delimiter="\t",
                           extrasaction="ignore", restval="")
        w.writeheader()
        w.writerows(rows)


def null_table(db, queries, counts):
    """Hit rates of real vs reversed vs shuffled peptides, by length."""
    rows = []
    lengths = sorted({len(q.seq) for q in queries if q.kind == "real"})
    for L in lengths + ["all"]:
        def sel(q):
            return L == "all" or len(q.seq) == L
        real = [counts[q.qid] > 0 for q in queries if q.kind == "real" and sel(q)]
        rev = [counts[q.qid] > 0 for q in queries if q.kind == "reverse" and sel(q)]
        by_rep = defaultdict(list)
        for q in queries:
            if q.kind == "shuffle" and sel(q):
                by_rep[q.rep].append(counts[q.qid] > 0)
        shuf = [float(np.mean(v)) for v in by_rep.values()]
        rows.append({
            "database": db, "length": L, "n_peptides": len(real),
            "real_hit_rate": round(float(np.mean(real)), 4) if real else "",
            "reverse_hit_rate": round(float(np.mean(rev)), 4) if rev else "",
            "shuffle_hit_rate_mean": round(float(np.mean(shuf)), 4) if shuf else "",
            "shuffle_hit_rate_min": round(min(shuf), 4) if shuf else "",
            "shuffle_hit_rate_max": round(max(shuf), 4) if shuf else "",
        })
    return rows


def sha256_of(path):
    h = hashlib.sha256()
    with open(path, "rb") as fh:
        for block in iter(lambda: fh.read(1 << 24), b""):
            h.update(block)
    return h.hexdigest()


