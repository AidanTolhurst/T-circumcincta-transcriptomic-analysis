def search_proteome(path, searcher, flank):
    names, seqs = [], []
    for name, seq in read_fasta(path):
        names.append(name)
        seqs.append(seq.upper().rstrip("*"))
    starts, total = [], 0
    for s in seqs:
        starts.append(total)
        total += len(s) + 1
    norm = "*".join(seqs).replace("I", "L")   # '*' separators cannot match

    def locate(pos, n):
        i = bisect.bisect_right(starts, pos) - 1
        off = pos - starts[i]
        return ({"subject": names[i], "strand": ".", "frame": "",
                 "aa_start": off + 1, "aa_end": off + n}, seqs[i], off, off + n)

    searcher.scan(norm, locate, flank)
    return len(seqs)


def six_frame_translate(dna: str):
    """Yield (strand, frame0, aa_bytes) for the six frames (standard code;
    codons with ambiguous bases become X)."""
    nt = NT_CODE[np.frombuffer(dna.encode("ascii", "replace"), dtype=np.uint8)]
    rc = nt[::-1].copy()
    known = rc < 4
    rc[known] = (rc[known] + 2) % 4
    for strand, arr in (("+", nt), ("-", rc)):
        for frame in range(3):
            n = (len(arr) - frame) // 3
            if n <= 0:
                continue
            tri = arr[frame:frame + 3 * n].reshape(n, 3)
            amb = (tri > 3).any(axis=1)
            idx = ((tri[:, 0].astype(np.int16) << 4)
                   | (tri[:, 1].astype(np.int16) << 2) | tri[:, 2])
            idx[amb] = 0
            aa = CODON_AA[idx]
            aa[amb] = ord("X")
            yield strand, frame, aa.tobytes()


def search_genome(path, searcher, flank):
    n_contigs = 0
    for name, dna in read_fasta(path):
        n_contigs += 1
        L = len(dna)
        for strand, frame, aa_bytes in six_frame_translate(dna):
            orig = aa_bytes.decode("ascii")
            norm = aa_bytes.translate(IL_BYTES).decode("ascii")

            def locate(pos, n):
                s0 = frame + 3 * pos                  # 0-based, on this strand
                if strand == "+":
                    nt_start, nt_end = s0 + 1, s0 + 3 * n
                else:                                 # back to forward coords
                    nt_start, nt_end = L - (s0 + 3 * n) + 1, L - s0
                return ({"subject": name, "strand": strand,
                         "frame": f"{strand}{frame + 1}",
                         "aa_start": pos + 1, "aa_end": pos + n,
                         "nt_start": nt_start, "nt_end": nt_end},
                        orig, pos, pos + n)

            searcher.scan(norm, locate, flank)
    return n_contigs


