save_fig <- function(plot, name, w = 7, h = 4.5) {
  ggsave(file.path(OUT_DIR, paste0(name, ".png")), plot, width = w, height = h, dpi = 300)
  ggsave(file.path(OUT_DIR, paste0(name, ".pdf")), plot, width = w, height = h)
}

# Figure 1: real hit rate against decoys, per database
overall <- null %>%
  transmute(database = db_label(database), Real = real_hit_rate, Reversed = reverse_hit_rate,
            Shuffled = shuffle_hit_rate_mean, lo = shuffle_hit_rate_min, hi = shuffle_hit_rate_max) %>%
  pivot_longer(c(Real, Reversed, Shuffled), names_to = "group", values_to = "rate") %>%
  mutate(group = factor(group, levels = names(group_col)),
         lo = ifelse(group == "Shuffled", lo, NA), hi = ifelse(group == "Shuffled", hi, NA),
         label_y = ifelse(is.na(hi), rate, hi))
fig1 <- ggplot(overall, aes(database, rate, fill = group)) +
  geom_col(position = position_dodge(0.8), width = 0.7, na.rm = TRUE) +
  geom_errorbar(aes(ymin = lo, ymax = hi), position = position_dodge(0.8), width = 0.2, na.rm = TRUE) +
  geom_text(aes(y = label_y, label = scales::percent(rate, accuracy = 0.1)),
            position = position_dodge(0.8), vjust = -0.5, size = 3, na.rm = TRUE) +
  scale_fill_manual(values = group_col, name = NULL) +
  scale_y_continuous(labels = scales::percent, expand = expansion(mult = c(0, 0.08))) +
  labs(x = NULL, y = "Proportion of peptides with ≥1 exact match(es)") +
  theme(axis.text.x = element_text(angle = 15, hjust = 1))
save_fig(fig1, "fig1_hit_rate_vs_decoys")

# Figure 2: how unlikely is each hit by chance?
evid <- bind_rows(lapply(intersect(c("proteome", "genome"), names(ST)), function(d)
  summ %>% filter(.data[[paste0(d, "_hits")]] > 0) %>%
    transmute(length, database = d, p = .data[[paste0(d, "_p_chance_match")]],
              context = best_context_support))) %>%
  mutate(database = db_label(database), score = -log10(pmax(p, 1e-300)),
         context = factor(context, levels = 0:3))
if (nrow(evid)) {
  fig2 <- ggplot(evid, aes(length, score, colour = context)) +
    geom_hline(yintercept = -log10(P_THRESHOLD), linetype = "dashed") +
    geom_point(size = 2, alpha = 0.85) +
    facet_wrap(~database, ncol = 1) +
    scale_colour_viridis_d(name = "Context\nsupport", drop = TRUE) +
    labs(x = "Peptide length (residues)", y = "-log10 (chance of a random match)",
         caption = sprintf("Dashed line: p = %g", P_THRESHOLD))
  save_fig(fig2, "fig2_chance_of_random_match", h = 6.5)
} else message("No peptide has a hit in the proteome or genome: figure 2 skipped.")

