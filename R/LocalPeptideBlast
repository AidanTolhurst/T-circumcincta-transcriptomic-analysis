# =============================================================================
#   1. Exact string matching of peptides against a protein FASTA (proteome),
#      a six-frame translation of a genome FASTA, and a host proteome.
#   2. Chance of a random match from database size and residue composition,
#      plus an empirical null from reversed and shuffled copies of each peptide.
#   3. Structural context of each hit (cleavage sites, amidation Gly,
#      crude signal-like N-terminus).
#   4. Three figures (fig1-3) and one Excel summary table, written to OUT_DIR.
#
# Needs: R >= 4.0 and the packages readr, dplyr, tidyr, ggplot2, writexl..
# =============================================================================

# ---- Executable Code ---------------------------------------------------------------
DATA_DIR   <- "" #To be set to your own directory
PEPTIDES   <- file.path(DATA_DIR, "AASequences.csv")     # one column: pepseq
PEP_COLUMN <- "pepseq"
PROTEOME   <- file.path(DATA_DIR, "Nematoda_proteins.fasta") #downloadable from https://www.uniprot.org/taxonomy/6231
GENOME     <- file.path(DATA_DIR, "teladorsagia_circumcincta_genome.fa") #downloadable from https://parasite.wormbase.org/Teladorsagia_circumcincta_prjna72569/Info/Index/
HOST       <- file.path(DATA_DIR, "Ovis_aries_proteins.fasta") #downloadable from https://www.uniprot.org/taxonomy/9940
OUT_DIR    <- file.path(DATA_DIR, "results")
PREFIX     <- "nematoda_map"


N_SHUFFLES  <- 100     # shuffled decoys per peptide
SEED        <- 1
MAX_HITS    <- 1000    # max hit rows kept per peptide per database
FLANK       <- 4       # residues reported either side of a hit
P_THRESHOLD <- 0.05 / 90   # Bonferonni correction for number of peptides


# Constants
MAX_K    <- 12L                      # longest key; longer peptides are verified in full
AA_ORDER <- "ACDEFGHKLMNPQRSTVWY"    # 19 letters: I is merged into L
AA_CODE  <- integer(256)             # 0 for '*', 'X' and anything else
AA_CODE[utf8ToInt(AA_ORDER) + 1L] <- 1:19
AA_CODE[utf8ToInt("I") + 1L]      <- AA_CODE[utf8ToInt("L") + 1L]
STANDARD_AA <- strsplit("ACDEFGHIKLMNPQRSTVWY", "")[[1]]
to_codes <- function(s) AA_CODE[as.integer(charToRaw(s)) + 1L]

NT_CODE <- rep(4L, 256)              # T,C,A,G = 0..3; anything else 4
NT_CODE[utf8ToInt("TCAGtcag") + 1L] <- c(0:3, 0:3)
CODON_RAW  <- charToRaw(paste0("FFLLSSSSYY**CC*WLLLLPPPPHHQQRRRRIIIMTTTTNNKKSSRRVVVVAAAADDEEGGGG", "X"))
CODON_CODE <- AA_CODE[as.integer(CODON_RAW) + 1L]   # 65th entry = ambiguous codon

DIBASIC <- c("KR", "RR")
KD <- c(A = 1.8, R = -4.5, N = -3.5, D = -3.5, C = 2.5, Q = -3.5, E = -3.5, G = -0.4,
        H = -3.2, I = 4.5, L = 3.8, K = -3.9, M = 1.9, F = 2.8, P = -1.6, S = -0.8,
        T = -0.7, W = -0.9, Y = -1.3, V = 4.2)

# Input checks and FASTA streaming
check_fasta <- function(path, kind) {
  if (!file.exists(path)) stop("File not found: ", path, call. = FALSE)
  tryCatch({
    con <- gzfile(path, "rt"); ln <- readLines(con, 60L, warn = FALSE); close(con)
    ln <- trimws(ln[nzchar(ln)])
    if (!length(ln) || !startsWith(ln[1], ">"))
      stop("the first line is not a FASTA header (a zip or damaged download?)")
    s <- toupper(paste(ln[!startsWith(ln, ">")], collapse = ""))
    if (!nchar(s)) stop("no sequence under the first header")
    nt <- mean(strsplit(s, "")[[1]] %in% c("A", "C", "G", "T", "U", "N"))
    if (kind == "protein" && nt > 0.95) stop("looks like DNA, not protein")
    if (kind == "dna" && nt < 0.8) stop("looks like protein, not DNA")
  }, error = function(e) stop(path, ": ", conditionMessage(e), call. = FALSE))
}

# Calls fn(names, sequences) on blocks of whole records.
stream_fasta <- function(path, fn, block_lines = 300000L) {
  con <- gzfile(path, "rt"); on.exit(close(con))
  carry <- character(0)
  repeat {
    new <- readLines(con, n = block_lines, warn = FALSE)
    eof <- length(new) < block_lines
    ln  <- c(carry, new); carry <- character(0)
    ln  <- trimws(ln[nzchar(ln)], "right")
    if (!length(ln)) { if (eof) break else next }
    hdr <- startsWith(ln, ">")
    if (!eof) {                                    # keep the last record for next block
      h <- which(hdr)
      if (length(h) < 2L) { carry <- ln; next }    # still inside one long record
      carry <- ln[max(h):length(ln)]
      ln <- ln[seq_len(max(h) - 1L)]; hdr <- hdr[seq_along(ln)]
    }
    rec  <- cumsum(hdr)
    seqs <- vapply(split(ln[!hdr], factor(rec[!hdr], levels = seq_len(sum(hdr)))),
                   paste, "", collapse = "")
    fn(sub("^>\\s*(\\S*).*$", "\\1", ln[hdr]), toupper(seqs))
    if (eof) break
  }
}

# Peptides and decoys
squash <- function(x) gsub("[^a-z0-9]", "", tolower(x))

load_peptides <- function(path, column) {
  raw <- read_csv(path, col_types = cols(.default = col_character()),
                  skip_empty_rows = FALSE, show_col_types = FALSE)
  j <- match(squash(column), squash(names(raw)))
  if (is.na(j)) stop("Column '", column, "' not found. Columns: ", paste(names(raw), collapse = ", "))
  seq  <- toupper(trimws(gsub("\\*+$", "", raw[[j]])))
  name <- paste0("pep_row", seq_along(seq) + 1L)      # row number in the file (header = row 1)
  keep <- !is.na(seq) & nzchar(seq)
  seq <- seq[keep]; name <- name[keep]
  bad <- vapply(strsplit(seq, ""), function(ch) paste(setdiff(ch, STANDARD_AA), collapse = ""), "")
  for (i in which(nzchar(bad))) warning("skipping '", name[i], "': unusable residues ", bad[i], call. = FALSE)
  seq <- seq[!nzchar(bad)]; name <- name[!nzchar(bad)]
  for (i in which(nchar(seq) < 6)) warning("'", name[i], "' is only ", nchar(seq[i]),
                                           " residues; expect many chance matches", call. = FALSE)
  list(seq = seq, name = name)
}

# Real peptides first, then reversed and shuffled copies (length and composition kept).
build_queries <- function(pep, n_shuffles) {
  seqs <- pep$seq; real_norm <- chartr("I", "L", seqs)
  dec <- vector("list", length(seqs) * (n_shuffles + 1L)); j <- 0L; skipped <- 0L
  for (i in seq_along(seqs)) {
    ch <- strsplit(seqs[i], "")[[1]]
    cand <- paste(rev(ch), collapse = "")
    if (chartr("I", "L", cand) %in% real_norm) skipped <- skipped + 1L
    else { j <- j + 1L; dec[[j]] <- list(cand, "reverse", i, 0L) }
    for (r in seq_len(n_shuffles)) {
      for (tt in 1:50) {
        cand <- paste(sample(ch), collapse = "")
        if (!(chartr("I", "L", cand) %in% real_norm)) break
      }
      if (chartr("I", "L", cand) %in% real_norm) skipped <- skipped + 1L
      else { j <- j + 1L; dec[[j]] <- list(cand, "shuffle", i, r) }
    }
  }
  dec <- dec[seq_len(j)]
  R <- length(seqs)
  Q <- list(
    seq    = c(seqs, vapply(dec, `[[`, "", 1)),
    kind   = c(rep("real", R), vapply(dec, `[[`, "", 2)),
    parent = c(seq_len(R), vapply(dec, `[[`, 0L, 3)),
    rep    = c(integer(R), vapply(dec, `[[`, 0L, 4)))
  Q$n    <- length(Q$seq)
  Q$name <- ifelse(Q$kind == "real", c(pep$name, rep("", Q$n - R))[seq_len(Q$n)],
                   paste0(Q$kind, ":", pep$name[Q$parent]))
  Q$len   <- nchar(Q$seq)
  Q$codes <- lapply(chartr("I", "L", Q$seq), to_codes)
  Q$k     <- pmin(Q$len, MAX_K); Q$kmax <- max(Q$k)
  Q$key   <- as.numeric(mapply(function(cd, k) Reduce(function(a, b) a * 20 + b, cd[seq_len(k)]),
                               Q$codes, Q$k))            # base-20 key of the first k residues
  Q$ukeys <- list(); Q$qlists <- list()
  for (k in sort(unique(Q$k))) {
    sel <- which(Q$k == k); u <- sort(unique(Q$key[sel]))
    Q$ukeys[[as.character(k)]]  <- u
    Q$qlists[[as.character(k)]] <- split(sel, factor(match(Q$key[sel], u), levels = seq_along(u)))
  }
  Q$skipped <- skipped
  Q
}

# Structural context of a hit (positions are 1-based, inclusive) 
signal_like <- function(segment, hit_offset) {
  m <- regexpr("M", segment, fixed = TRUE)[1] - 1L          # 0-based, -1 if no Met
  if (m < 0L || hit_offset - m < 20L) return(FALSE)
  vals <- unname(KD[strsplit(substr(segment, m + 1L, m + 35L), "")[[1]]]); vals[is.na(vals)] <- 0
  if (length(vals) < 11L) return(FALSE)
  cs <- c(0, cumsum(vals)); a <- 4:(length(vals) - 7L)
  any((cs[a + 8L] - cs[a]) / 8 >= 1.6)
}

hit_context <- function(hay, s, e) {
  L <- nchar(hay)
  stops <- gregexpr("*", substr(hay, 1L, s - 1L), fixed = TRUE)[[1]]
  seg_start <- if (stops[1] == -1L) 1L else max(stops) + 1L
  nxt <- regexpr("*", substr(hay, e + 1L, L), fixed = TRUE)[1]
  seg_end <- if (nxt == -1L) L else e + nxt - 1L
  up   <- substr(hay, max(seg_start, s - FLANK), s - 1L)
  down <- substr(hay, e + 1L, min(seg_end, e + FLANK))
  up2  <- substring(up, pmax(nchar(up) - 1L, 1L)); up1 <- substring(up, nchar(up))
  n_site <- if (s == seg_start) "segment_start" else if (up2 %in% DIBASIC) "dibasic" else
    if (up1 %in% c("K", "R")) "monobasic" else "none"
  c_site <- if (e == seg_end) "segment_end" else if (substr(down, 1, 2) %in% DIBASIC) "dibasic" else
    if (substr(down, 1, 1) %in% c("K", "R")) "monobasic" else "none"
  amid <- if (substr(down, 1, 1) != "G") "none" else if (substr(down, 2, 3) %in% DIBASIC) "G+dibasic" else
    if (substr(down, 2, 2) %in% c("K", "R")) "G+monobasic" else "G"
  sig <- signal_like(substr(hay, seg_start, seg_end), s - seg_start)
  list(upstream = up, downstream = down, n_site = n_site, c_site = c_site,
       amidation_signal = amid, signal_like_nterm = sig, precursor_len = seg_end - seg_start + 1L,
       context_support = (n_site %in% c("dibasic", "monobasic")) +
         (c_site %in% c("dibasic", "monobasic") || amid %in% c("G+dibasic", "G+monobasic")) + sig)
}

# Exact-match search engine
# codes: integer residue codes (0 = separator/stop/unknown). Each window is turned
# into a base-20 number, looked up among the queries' keys, and long peptides are
# then checked in full. Returns data.frame(qid, pos) for every query, decoys included.
find_hits <- function(codes, Q, chunk = 8e6) {
  n <- length(codes)
  if (n == 0L) return(data.frame(qid = integer(), pos = numeric()))
  pad <- c(codes, integer(MAX_K)); acc <- list()
  for (off in seq(0, n - 1, by = chunk)) {
    w <- min(chunk, n - off); key <- numeric(w)
    for (j in seq_len(Q$kmax)) {
      key <- key * 20 + pad[(off + j):(off + w + j - 1)]
      k <- as.character(j)
      if (is.null(Q$ukeys[[k]])) next
      m <- match(key, Q$ukeys[[k]]); p <- which(!is.na(m))
      if (length(p)) {
        ql <- Q$qlists[[k]][m[p]]
        acc[[length(acc) + 1L]] <- data.frame(qid = unlist(ql), pos = rep(off + p, lengths(ql)))
      }
    }
  }
  h <- if (length(acc)) do.call(rbind, acc) else data.frame(qid = integer(), pos = numeric())
  long <- which(Q$len[h$qid] > Q$k[h$qid])
  if (length(long)) {
    ok <- vapply(long, function(i) {
      q <- h$qid[i]; e <- h$pos[i] + Q$len[q] - 1
      e <= n && all(codes[h$pos[i]:e] == Q$codes[[q]])
    }, logical(1))
    keep <- rep(TRUE, nrow(h)); keep[long[!ok]] <- FALSE; h <- h[keep, , drop = FALSE]
  }
  h
}

new_state <- function(Q) {
  st <- new.env()
  st$counts <- integer(Q$n); st$stored <- integer(Q$n); st$comp <- numeric(19)
  st$positions <- 0; st$n_seq <- 0L; st$rows <- list()
  st
}

# Search one block of codes; tally all queries, return the (capped) real-peptide hits.
scan_codes <- function(st, Q, codes) {
  h <- find_hits(codes, Q)
  st$counts    <- st$counts + tabulate(h$qid, Q$n)
  st$comp      <- st$comp + tabulate(codes, 19L)
  st$positions <- st$positions + length(codes)
  rh <- h[Q$kind[h$qid] == "real", , drop = FALSE]
  if (nrow(rh)) {
    rank <- ave(rh$qid, rh$qid, FUN = seq_along) + st$stored[rh$qid]
    rh <- rh[rank <= MAX_HITS, , drop = FALSE]
    st$stored <- st$stored + tabulate(rh$qid, Q$n)
  }
  rh
}

hit_row <- function(Q, qid, subject, strand, frame, s, e, nt_s, nt_e, hay) {
  mseq <- substr(hay, s, e)
  c(list(peptide_id = Q$name[qid], peptide = Q$seq[qid], length = Q$len[qid], subject = subject,
         strand = strand, frame = frame, aa_start = s, aa_end = e, nt_start = nt_s, nt_end = nt_e,
         matched_seq = mseq, il_variant = mseq != Q$seq[qid]),
    hit_context(hay, s, e), list(qid = qid))
}

scan_protein <- function(path, Q, st) {
  stream_fasta(path, function(nm, sq) {
    sq <- sub("\\*+$", "", sq)
    starts <- cumsum(c(1, nchar(sq, "bytes") + 1))[seq_along(sq)]
    st$n_seq <- st$n_seq + length(sq)
    rh <- scan_codes(st, Q, to_codes(paste(sq, collapse = "*")))   # '*' separators never match
    if (nrow(rh)) {
      i <- findInterval(rh$pos, starts); s <- rh$pos - starts[i] + 1
      st$rows[[length(st$rows) + 1L]] <- bind_rows(lapply(seq_len(nrow(rh)), function(r)
        hit_row(Q, rh$qid[r], nm[i[r]], ".", "", s[r], s[r] + Q$len[rh$qid[r]] - 1, NA, NA, sq[i[r]])))
    }
  })
}

translate_frame <- function(dna, strand, f) {     # amino-acid string with I kept; stops = '*'
  nt <- NT_CODE[as.integer(charToRaw(dna)) + 1L]
  if (strand == "-") { nt <- rev(nt); k <- nt < 4L; nt[k] <- (nt[k] + 2L) %% 4L }
  n <- (length(nt) - f) %/% 3L
  if (n <= 0L) return("")
  i <- f + 3L * (seq_len(n) - 1L) + 1L
  idx <- nt[i] * 16L + nt[i + 1L] * 4L + nt[i + 2L] + 1L
  idx[nt[i] > 3L | nt[i + 1L] > 3L | nt[i + 2L] > 3L] <- 65L
  rawToChar(CODON_RAW[idx])
}

# Contigs are joined with NNN (codons containing N never match), so each batch is
# translated in 6 frames at once; frames and coordinates are converted back per contig.
scan_genome <- function(path, Q, st) {
  stream_fasta(path, function(nm, sq) {
    st$n_seq <- st$n_seq + length(sq)
    Lc <- nchar(sq, "bytes"); cstart <- cumsum(c(1, Lc + 3))[seq_along(sq)]
    nt <- NT_CODE[as.integer(charToRaw(paste(sq, collapse = "NNN"))) + 1L]
    Lcat <- length(nt)
    rc <- rev(nt); kn <- rc < 4L; rc[kn] <- (rc[kn] + 2L) %% 4L
    cache <- new.env()
    for (strand in c("+", "-")) {
      arr <- if (strand == "+") nt else rc
      for (f in 0:2) {
        n <- (Lcat - f) %/% 3L
        if (n <= 0L) next
        i <- f + 3L * (seq_len(n) - 1L) + 1L
        b1 <- arr[i]; b2 <- arr[i + 1L]; b3 <- arr[i + 2L]
        idx <- b1 * 16L + b2 * 4L + b3 + 1L
        idx[b1 > 3L | b2 > 3L | b3 > 3L] <- 65L
        rh <- scan_codes(st, Q, CODON_CODE[idx])
        if (!nrow(rh)) next
        n3 <- 3 * Q$len[rh$qid]; s0 <- f + 3 * (rh$pos - 1)
        if (strand == "+") { ns <- s0 + 1; ne <- s0 + n3 } else { ns <- Lcat - (s0 + n3) + 1; ne <- Lcat - s0 }
        ci <- findInterval(ns, cstart); ls <- ns - cstart[ci] + 1; le <- ne - cstart[ci] + 1
        if (strand == "+") { fr <- (ls - 1) %% 3; aa_s <- (ls - 1) %/% 3 + 1 }
        else               { s0l <- Lc[ci] - le; fr <- s0l %% 3; aa_s <- s0l %/% 3 + 1 }
        st$rows[[length(st$rows) + 1L]] <- bind_rows(lapply(seq_len(nrow(rh)), function(r) {
          key <- paste(ci[r], strand, fr[r]); hay <- cache[[key]]
          if (is.null(hay)) { hay <- translate_frame(sq[ci[r]], strand, fr[r]); cache[[key]] <- hay }
          hit_row(Q, rh$qid[r], nm[ci[r]], strand, paste0(strand, fr[r] + 1), aa_s[r],
                  aa_s[r] + Q$len[rh$qid[r]] - 1, ls[r], le[r], hay)
        }))
      }
    }
  })
}

# Run 
DBS <- Filter(Negate(is.null), list(proteome = PROTEOME, genome = GENOME, host = HOST))
if (!length(DBS)) stop("Set at least one of PROTEOME, GENOME, HOST.")
for (d in names(DBS)) check_fasta(DBS[[d]], if (d == "genome") "dna" else "protein")  # fail fast

set.seed(SEED)
pep <- load_peptides(PEPTIDES, PEP_COLUMN)
if (!length(pep$seq)) stop("No usable peptides.")
Q <- build_queries(pep, N_SHUFFLES)
R <- length(pep$seq)
message(R, " peptides, ", Q$n - R, " decoys (", Q$skipped, " decoys skipped: palindromic/low-complexity)")

ST <- list()
for (d in names(DBS)) {
  message("[", d, "] searching ", DBS[[d]], " ...")
  t0 <- Sys.time(); ST[[d]] <- new_state(Q)
  (if (d == "genome") scan_genome else scan_protein)(DBS[[d]], Q, ST[[d]])
  message("[", d, "] ", format(ST[[d]]$n_seq, big.mark = ","), " sequences, ",
          format(ST[[d]]$positions, big.mark = ",", scientific = FALSE), " positions searched in ",
          round(as.numeric(difftime(Sys.time(), t0, units = "mins")), 1), " min")
}

# Hits table
hits <- bind_rows(lapply(names(ST), function(d)
  if (length(ST[[d]]$rows)) bind_rows(ST[[d]]$rows) %>% mutate(database = d)))
if (!nrow(hits)) hits <- tibble(database = character(), qid = integer(), context_support = numeric())
# Per-peptide summary
real <- seq_len(R); shuf <- which(Q$kind == "shuffle"); revq <- which(Q$kind == "reverse")
summ <- tibble(peptide_id = pep$name, peptide = pep$seq, length = Q$len[real])
for (d in names(ST)) {
  st <- ST[[d]]; p_aa <- st$comp / sum(st$comp)
  E  <- st$positions * vapply(real, function(i) prod(p_aa[Q$codes[[i]]]), 0)
  k  <- tabulate(Q$parent[shuf][st$counts[shuf] > 0], R); n <- tabulate(Q$parent[shuf], R)
  rv <- rep(NA_integer_, R); rv[Q$parent[revq]] <- st$counts[revq]
  summ[[paste0(d, "_hits")]]            <- st$counts[real]
  summ[[paste0(d, "_expected_random")]] <- signif(E, 3)
  summ[[paste0(d, "_expected_naive")]]  <- signif(st$positions * 20^-Q$len[real], 3)
  summ[[paste0(d, "_p_chance_match")]]  <- signif(-expm1(-E), 3)
  summ[[paste0(d, "_shuffle_hits")]]    <- ifelse(n > 0, paste0(k, "/", n), NA)
  summ[[paste0(d, "_empirical_p")]]     <- ifelse(n > 0, signif((k + 1) / (n + 1), 3), NA)
  summ[[paste0(d, "_reverse_hits")]]    <- rv
}
ctx <- if (nrow(hits)) hits %>% filter(database != "host") %>% group_by(qid) %>%
  summarise(best = max(context_support), .groups = "drop") else tibble(qid = integer(), best = numeric())
summ$best_context_support <- ctx$best[match(real, ctx$qid)]

found <- function(d) if (d %in% names(ST)) summ[[paste0(d, "_hits")]] > 0 else rep(FALSE, R)
genome_label <- if ("proteome" %in% names(ST)) "genome_only" else "in_genome"
summ$status <- ifelse(found("proteome"), "in_predicted_proteome",
                      ifelse(found("genome"), genome_label, "not_found"))
summ$status <- ifelse(found("host"), paste0(summ$status, ";ALSO_IN_HOST"), summ$status)

# Overall hit rates: real vs reversed vs shuffled 
Qlite <- data.frame(qid = seq_len(Q$n), kind = Q$kind, rep = Q$rep)
null_table <- function(db, counts) {
  d <- mutate(Qlite, hit = counts[qid] > 0)
  rl <- d$hit[d$kind == "real"]; rv <- d$hit[d$kind == "reverse"]
  sh <- as.numeric(tapply(d$hit[d$kind == "shuffle"], d$rep[d$kind == "shuffle"], mean))
  tibble(database = db, real_hit_rate = mean(rl),
         reverse_hit_rate = if (length(rv)) mean(rv) else NA_real_,
         shuffle_hit_rate_mean = if (length(sh)) mean(sh) else NA_real_,
         shuffle_hit_rate_min  = if (length(sh)) min(sh) else NA_real_,
         shuffle_hit_rate_max  = if (length(sh)) max(sh) else NA_real_)
}
null <- bind_rows(lapply(names(ST), function(d) null_table(d, ST[[d]]$counts)))

# Evidence table 
weak <- Reduce(`|`, lapply(intersect(c("proteome", "genome"), names(ST)), function(d)
  summ[[paste0(d, "_hits")]] > 0 & summ[[paste0(d, "_p_chance_match")]] > P_THRESHOLD), FALSE)
evidence <- summ %>%
  select(peptide_id, peptide, length, status,
         any_of(c("proteome_hits", "proteome_p_chance_match", "genome_hits",
                  "genome_p_chance_match", "host_hits")), best_context_support) %>%
  rename(any_of(c(proteome_p = "proteome_p_chance_match", genome_p = "genome_p_chance_match"))) %>%
  mutate(weak_by_chance = weak)

# Excel summary table
xlsx_path <- file.path(OUT_DIR, paste0(PREFIX, "_summary_table.xlsx"))
write_xlsx(list(peptide_evidence = evidence), xlsx_path)

